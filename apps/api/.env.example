# =============================================================================
# boilerplate/apps/api — backend-only environment (copy to `.env`, never commit)
# Demo values are placeholders; replace with real credentials in production.
# =============================================================================

# --- Server ---
PORT=5050
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/boilerplate
# Atlas: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/boilerplate?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/boilerplate

# --- Auth ---
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# --- CORS (comma-separated origins; must include your Vite dev server) ---
CORS_ORIGINS=http://localhost:5173

# --- AWS (S3 / Cognito / etc.) — demo keys only ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Bucket for uploads / plugin assets (align with Relmes-backend naming if you merge later)
S3_BUCKET_NAME=relmes-boilerplate-demo
# Optional public CDN / CloudFront base (no trailing slug paths required)
AWS_CDN_BASE_URL=https://d111111abcdef8.cloudfront.net

# --- Nodemailer (SMTP) — required if you send mail from this API ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=demo-user
SMTP_PASS=demo-app-password-or-api-key
MAIL_FROM="Boilerplate API <noreply@example.com>"
# Optional: separate reply-to
# MAIL_REPLY_TO=support@example.com

# --- Relmes integration (when calling main Relmes-backend from this service) ---
# RELMES_BACKEND_URL=http://localhost:5005

