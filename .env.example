# =============================================================================
# Relmes Chess — single monorepo environment
# Copy to `.env` at this folder root (plugins/chess/.env). Never commit `.env`.
# Vercel: add these same variables once in the project Environment Variables UI.
# =============================================================================

VITE_API_URL=
VITE_RELMES_PARENT_ORIGINS=
VITE_RELMES_API_URL=http://localhost:5005
VITE_RELMES_PLUGIN_ID=

# --- API (server) ---
PORT=5020
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/chess
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
RELMES_BACKEND_URL=http://localhost:5005
# Vercel auto-adds https://$VERCEL_URL to CORS when deployed as one project.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://relmes.in,https://www.relmes.in

# --- Web (Vite — only VITE_* are exposed to the browser) ---
# Leave empty in dev (Vite proxies /api) and for single-project Vercel deploy (same-origin /api).
